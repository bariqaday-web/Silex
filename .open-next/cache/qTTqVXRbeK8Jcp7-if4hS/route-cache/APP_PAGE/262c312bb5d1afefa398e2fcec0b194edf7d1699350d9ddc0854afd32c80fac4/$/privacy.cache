":[\"$\",\"$L9\",null,{\"href\":\"/profile/app-settings\",\"className\":\"inline-flex min-h-10 items-center gap-2 text-sm font-medium text-ink/75 transition-colors hover:text-ink\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-arrow-right\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1ays0h\",{\"d\":\"M5 12h14\"}],[\"$\",\"path\",\"xquz4c\",{\"d\":\"m12 5 7 7-7 7\"}],\"$undefined\"]}],\"العودة إلى الإعدادات\"]}]}],[\"$\",\"h1\",null,{\"className\":\"font-display text-2xl\",\"children\":\"سياسة الخصوصية\"}],[\"$\",\"p\",null,{\"className\":\"mt-1 text-xs text-muted\",\"children\":[\"آخر تحديث: \",\"5 أكتوبر 2026\"]}],[\"$\",\"div\",null,{\"className\":\"mt-6 space-y-6 text-sm leading-7 text-ink/85\",\"children\":[[\"$\",\"section\",null,{\"className\":\"space-y-2\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-base text-ink\",\"children\":\"مقدمة\"}],[\"$\",\"p\",null,{\"children\":\"ساليكس منصة للتسوق والتواصل بين الزبائن والتجار. يشغّل المنصة استبرق عداي («نحن»). تشرح هذه السياسة البيانات التي نعالجها، وأسباب استخدامها، والخيارات المتاحة لك. باستخدامك للمنصة، فأنت تقر بأنك اطلعت على هذه السياسة.\"}]]}],[\"$\",\"section\",null,{\"className\":\"space-y-2\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-base text-ink\",\"children\":\"البيانات التي تقدمها أو تنشئها\"}],[\"$\",\"ul\",null,{\"className\":\"list-disc space-y-1 pr-5\",\"children\":[[\"$\",\"li\",null,{\"children\":\"الحساب: الاسم والبريد الإلكتروني وبيانات المصادقة، بما فيها بيانات Google الأساسية عند اختيار تسجيل الدخول عبر Google.\"}],[\"$\",\"li\",null,{\"children\":\"الملف الشخصي والمتجر: اسم المستخدم والصورة والنبذة وروابط التواصل ورقم WhatsApp والدولة والمدينة وبيانات المتجر.\"}],[\"$\",\"li\",null,{\"children\":\"المحتوى: المنتجات والمنشورات والقصص والتعليقات والصور ومقاطع الفيديو والرسائل والمرفقات التي تختار إرسالها.\"}],\"$La\",\"$Lb\",\"$Lc\"]}]]}],\"$Ld\",\"$Le\",\"$Lf\",\"$L10\",\"$L11\",\"$L12\",\"$L13\",\"$L14\",\"$L15\"]}]]}],null,\"$L16\"]}],{},null,false]},null,false]},null,false],\"$L17\",false]],\"m\":\"$undefined\",\"G\":[\"$18\",[]],\"s\":false,\"S\":true}\n19:I[24431,[],\"OutletBoundary\"]\n1b:I[15278,[],\"AsyncMetadataOutlet\"]\n1d:I[24431,[],\"ViewportBoundary\"]\n1f:I[24431,[],\"MetadataBoundary\"]\n20:\"$Sreact.suspense\"\na:[\"$\",\"li\",null,{\"children\":\"التجارة: الطلبات والمنتجات والمخزون وبيانات دفتر الديون والإعلانات وإيصالات الدفع التي ترفعها للحملات التي تتطلب دفعاً.\"}]\nb:[\"$\",\"li\",null,{\"children\":\"بيانات المكالمات: نوع المكالمة وحالتها ومدتها وسجلاتها ضمن المحادثة. لا يطلب التطبيق إذن الكاميرا أو الميكروفون إلا عند استخدام ميزاتهما.\"}]\nc:[\"$\",\"li\",null,{\"children\":\"تُحفظ السلة والمفضلة وبعض تفضيلاتك محلياً على جهازك أو متصفحك.\"}]\nd:[\"$\",\"section\",null,{\"className\":\"space-y-2\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-base text-ink\",\"children\":\"بيانات الاستخدام والأذونات\"}],[\"$\",\"p\",null,{\"children\":\"عند استخدام الحساب، نسجل وقت آخر نشاط. وقد نسجل تاريخ وساعة الاستخدام والدولة والمدينة اللتين أدخلتهما في ملفك ضمن إحصاءات استخدام مجمعة؛ تحتفظ هذه الإحصاءات لمدة تصل إلى 90 يوماً. لا يستخدم هذا التحليل GPS أو تحديد الموقع عبر عنوان IP. يمكن أن يطلب التطبيق إذن الكاميرا أو الميكروفون لالتقاط أو تسجيل محتوى أو لإجراء مكالمة، وإذن الإشعارات لإرسال التنبيهات؛ يمكنك رفض الأذونات أو تغييرها من إعدادات جهازك.\"}]]}]\ne:[\"$\",\"section\",null,{\"className\":\"space-y-2\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-base text-ink\",\"children\":\"كيف نستخدم البيانات\"}],[\"$\",\"p\",null,{\"children\":\"نستخدم البيانات لإنشاء الحساب وتأمينه، وتشغيل السوق والطلبات والمحادثات والمكالمات، وعرض المحتوى الذي تنشره، وإدارة المتاجر والإعلانات، وإرسال الإشعارات التي تختار تفعيلها، وتقديم الدعم، ومنع الاحتيال وإساءة الاستخدام، وتحسين الخدمة وقياس استخدامها.\"}]]}]\nf:[\"$\",\"section\",null,{\"className\":\"space-y-2\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-base text-ink\",\"children\":\"المشاركة ومقدمو الخدمات\"}],[[\"$\",\"p\",null,{\"children\":\"لا نبيع بياناتك الشخصية. يظهر المحتوى والبيانات التي تجعلها عامة لمستخدمي المنصة، وتُشارك تفاصيل الطلب التي تختار إرسالها مع التاجر المعني. إذا اخترت إكمال طلب عبر WhatsApp، تُفتح خدمة WhatsApp وتُرسل إليها تفاصيل الطلب لإرسالها إلى التاجر.\"}],[\"$\",\"p\",null,{\"children\":\"نستخدم مزودي خدمات لمعالجة البيانات اللازمة لتشغيل الميزات، ومنهم:\"}],[\"$\",\"ul\",null,{\"className\":\"list-disc space-y-1 pr-5\",\"children\":[[\"$\",\"li\",null,{\"children\":\"Supabase لاستضافة قاعدة البيانات والمصادقة وتخزين الملفات.\"}],[\"$\",\"li\",null,{\"children\":\"Google عند اختيار تسجيل الدخول باستخدام Google.\"}],[\"$\",\"li\",null,{\"children\":\"OneSignal لإشعارات الدفع عند إعداد الخدمة وموافقتك على الإشعارات.\"}],[\"$\",\"li\",null,{\"children\":\"Agora لمعالجة الاتصال الصوتي أو المرئي أثناء المكالمات التي تبدأها أو تجيب عنها.\"}]]}],[\"$\",\"p\",null,{\"children\":\"قد تعالج هذه الجهات البيانات وفق سياساتها وشروطها الخاصة.\"}]]]}]\n10:[\"$\",\"section\",null,{\"className\":\"space-y-2\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-base text-ink\",\"children\":\"الاحتفاظ بالبيانات وحذف الحساب\"}],[[\"$\",\"p\",null,{\"children\":\"نحتفظ ببيانات الحساب والمحتوى ما دام الحساب قائماً، ثم نعالج طلب الحذف وفق الخطوات الموضحة في صفحة الحذف.\"}],[\"$\",\"p\",null,{\"children\":[\"يمكنك الاطلاع على خطوات تقديم طلب الحذف من\",\" \",[\"$\",\"$L9\",null,{\"href\":\"/delete-account\",\"className\":\"font-semibold underline\",\"children\":\"صفحة حذف الحساب\"}],\". قد نحتفظ ببعض السجلات للمدة اللازمة لمعالجة الطلبات أو الوفاء بالالتزامات القانونية، كما قد تستمر نسخ احتياطية لدى مزودي الخدمة وفق مدد الاحتفاظ الخاصة بهم.\"]}]]]}]\n11:[\"$\",\"section\",null,{\"className\":\"space-y-2\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-base text-ink\",\"children\":\"اختياراتك وحقوقك\"}],[\"$\",\"p\",null,{\"children\":\"يمكنك تعديل بيانات ملفك من إعدادات الحساب، وإيقاف الإشعارات من إعدادات الجهاز، وطلب حذف حسابك من داخل المنصة. يمكنك كذلك التواصل معنا لطلب المساعدة بشأن بياناتك.\"}]]}]\n12:[\"$\",\"section\",null,{\"className\":\"space-y-2\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-base text-ink\",\"children\":\"الأمان\"}],[\"$\",\"p\",null,{\"children\":\"نستخدم اتصالاً مشفراً وضوابط وصول لحماية البيانات، لكن لا توجد وسيلة نقل أو تخزين آمنة بصورة مطلقة.\"}]]}]\n13:[\"$\",\"section\",null,{\"className\":\"space-y-2\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-base text-ink\",\"children\":\"الأطفال\"}],[\"$\",\"p\",null,{\"children\":\"المنصة غير موجهة للأطفال دون 13 عاماً، ولا نقصد جمع بياناتهم.\"}]]}]\n14:[\"$\",\"section\",null,{\"className\":\"space-y-2\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-base text-ink\",\"children\":\"التواصل\"}],[\"$\",\"p\",null,{\"children\":[\"مالك المنصة: استبرق عداي. للاستفسارات المتعلقة بالخصوصية\",[\": \",[\"$\",\"a\",null,{\"href\":\"mailto:barqaday@gmail.com\",\"className\":\"underline\",\"children\":\"barqaday@gmail.com\"}]]]}]]}]\n15:[\"$\",\"section\",null,{\"className\":\"space-y-2\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-base text-ink\",\"children\":\"تعديل السياسة\"}],[\"$\",\"p\",null,{\"children\":\"قد نحدّث هذه السياسة عند تغيير الخدمة أو طريقة معالجة البيانات. ننشر النسخة المحدثة وتاريخها في هذه الصفحة.\"}]]}]\n16:[\"$\",\"$L19\",null,{\"children\":[\"$L1a\",[\"$\",\"$L1b\",null,{\"promise\":\"$@1c\"}]]}]\n17:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L1d\",null,{\"children\":\"$L1e\"}],null],[\"$\",\"$L1f\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$20\",null,{\"fallback\":null,\"children